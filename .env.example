# دامنه و لینک ورود رسمی پس از تأیید تنظیم می‌شوند.
# مقدارهای NEXT_PUBLIC محرمانه نیستند؛ secrets را در این فایل ننویسید.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Compose توسعه: با scripts/setup-development.ps1 رمز تصادفی محلی بسازید.
# رمزهای اتصال باید URI-safe باشند (اسکریپت از ۳۲ بایت hex استفاده می‌کند).
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
API_DB_PASSWORD=

# اجرای API خارج Docker: متغیر محیطی ضروری؛ هرگز مقدار واقعی را در Git ثبت نکنید.
APP_ENV=development
DATABASE_URL=
