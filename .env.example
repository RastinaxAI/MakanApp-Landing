# دامنه، لینک ورود و تماس رسمی از مرحله۶ در CMS ذخیره می‌شوند؛ کلیدها در CMS قرار نمی‌گیرند.

# Compose توسعه: با scripts/setup-development.ps1 رمز تصادفی محلی بسازید.
# رمزهای اتصال باید URI-safe باشند (اسکریپت از ۳۲ بایت hex استفاده می‌کند).
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
API_DB_PASSWORD=

# اجرای API خارج Docker: متغیر محیطی ضروری؛ هرگز مقدار واقعی را در Git ثبت نکنید.
APP_ENV=development
DATABASE_URL=

# دو کلید مستقل ۳۲ بایتی hex؛ setup آن‌ها را تصادفی می‌سازد و مقادیر موجود را حفظ می‌کند.
AUTH_SECRET=
AUTH_MFA_KEY=
# JSON از origin دقیق، بدون slash پایانی؛ در staging/production فقط HTTPS.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://127.0.0.1:3100"]

# فقط server-side وب؛ مقدار محلی در apps/web/.env.local، هرگز NEXT_PUBLIC نیست.
API_INTERNAL_URL=http://127.0.0.1:8000

# مسیر رسانه در اجرای محلی؛ Compose از /srv/media و Volume پایدار استفاده می‌کند.
MEDIA_ROOT=.media
