[Unit]
Description=Makan landing services and backup freshness
After=docker.service

[Service]
Type=oneshot
User=makan-operator
WorkingDirectory=/opt/makan-landing
UMask=0077
ExecStart=/opt/makan-landing/apps/api/.venv/bin/python scripts/production.py --env-file /etc/makan-landing/production.env status --backup-directory /var/backups/makan-landing
NoNewPrivileges=true
