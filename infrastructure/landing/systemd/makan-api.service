# Managed by makan landing
[Unit]
Description=Makan landing FastAPI
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=makan
Group=makan
WorkingDirectory=/opt/makan/current/apps/api
EnvironmentFile=/etc/makan/api.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/makan/current/apps/api/.venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/makan/media

[Install]
WantedBy=multi-user.target
