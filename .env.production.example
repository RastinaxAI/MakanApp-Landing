# Copy outside Git; production.py init generates distinct random keys/passwords.
COMPOSE_PROJECT_NAME=makan-landing-prod
APP_ENV=production
SITE_DOMAIN=
PUBLIC_ORIGIN=
POSTGRES_DB=makan_landing
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
API_DB_PASSWORD=
AUTH_SECRET=
AUTH_MFA_KEY=
PROXY_SHARED_SECRET=
# Keep an offline copy separately from the encrypted backup archive.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=
# Operational proposal; owner must approve retention, destination, RPO and RTO before launch.
BACKUP_RETENTION_DAYS=7
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
CADDY_CONFIG=/etc/caddy/Caddyfile
API_IMAGE=makan-landing-api:0.10.0
DB_IMAGE=makan-landing-postgres:17.11
WEB_IMAGE=makan-landing-web:0.10.0
PROXY_IMAGE=makan-landing-caddy:2.11.7
SEO_INDEXING_ENABLED=false
ANALYTICS_ENABLED=false
PUBLIC_POLICY_APPROVED=false
FORMS_TOKEN_LIMIT=40
FORMS_SUBMIT_LIMIT=20
FORMS_CONTACT_LIMIT=5
ANALYTICS_EVENT_LIMIT=240
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_CHALLENGE_LIMIT=30
